<form method="post" action="{{ path('app_collect_delete', {'id': collect.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir retirer {{ collect.jeuVideo.titre|e('js') }} de la collection de {{ collect.utilisateur.pseudo|e('js') }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ collect.id) }}">
    <button class="btn btn-danger">{{ ux_icon('lucide:trash-2', {class: 'size-4'}) }} Supprimer</button>
</form>