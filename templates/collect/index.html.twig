{% extends 'base.html.twig' %}

{% block title %}Collections{% endblock %}

{% block breadcrumb_items %}
    {{ include('_partials/breadcrumb_item.html.twig', {label: 'Collections'}) }}
{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="page-title">Collections</h1>
        <a href="{{ path('app_collect_new', filtreUtilisateur ? {utilisateur: filtreUtilisateur.id} : {}) }}" class="btn btn-primary">{{ ux_icon('lucide:plus', {class: 'size-4'}) }} Ajouter un jeu</a>
    </div>

    {# ============================ FILTRES ============================ #}
    {% set filtre_actif = filtreUtilisateur or filtreStatut %}
    <form method="get" action="{{ path('app_collect_index') }}" class="card mb-4 flex flex-wrap items-end gap-4 p-4">
        <div class="flex min-w-48 flex-1 flex-col gap-1">
            <label for="filtre-utilisateur" class="text-sm font-medium text-slate-700">Joueur</label>
            <select id="filtre-utilisateur" name="utilisateur" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none">
                <option value="">Tous les joueurs</option>
                {% for utilisateur in utilisateurs %}
                    <option value="{{ utilisateur.id }}" {{ filtreUtilisateur and filtreUtilisateur.id == utilisateur.id ? 'selected' }}>
                        {{ utilisateur.pseudo }} ({{ utilisateur.prenom }} {{ utilisateur.nom|upper }})
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="flex min-w-48 flex-1 flex-col gap-1">
            <label for="filtre-statut" class="text-sm font-medium text-slate-700">Statut</label>
            <select id="filtre-statut" name="statut" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none">
                <option value="">Tous les statuts</option>
                {% for statut in statuts %}
                    <option value="{{ statut.value }}" {{ filtreStatut == statut ? 'selected' }}>{{ statut.getLabel }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">{{ ux_icon('lucide:filter', {class: 'size-4'}) }} Filtrer</button>
            {% if filtre_actif %}
                <a href="{{ path('app_collect_index') }}" class="btn">{{ ux_icon('lucide:x', {class: 'size-4'}) }} Réinitialiser</a>
            {% endif %}
        </div>
    </form>

    <p class="mb-2 text-sm text-slate-500">{{ collects|length }} résultat{{ collects|length > 1 ? 's' }}</p>

    <div class="card overflow-x-auto p-0">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Jeu</th>
                    <th>Joueur</th>
                    <th>Statut</th>
                    <th>Prix payé</th>
                    <th>Écart</th>
                    <th>Date d'achat</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for collect in collects %}
                <tr>
                    <td class="text-slate-400">{{ collect.id }}</td>
                    <td class="font-medium text-slate-900">{{ collect.jeuVideo.titre }}</td>
                    <td>{{ collect.utilisateur.pseudo }}</td>
                    <td>{{ include('collect/_statut_badge.html.twig', {collect: collect}) }}</td>
                    <td>{{ collect.prixAchat|format_currency('EUR', locale: 'fr') }}</td>
                    <td>{{ include('collect/_ecart.html.twig', {collect: collect}) }}</td>
                    <td>{{ collect.dateAchat ? collect.dateAchat|date('d/m/Y') : '—' }}</td>
                    <td>
                        <div class="flex justify-end gap-2">
                            <a href="{{ path('app_collect_show', {'id': collect.id}) }}" class="btn btn-sm">{{ ux_icon('lucide:eye', {class: 'size-3.5'}) }} Consulter</a>
                            <a href="{{ path('app_collect_edit', {'id': collect.id}) }}" class="btn btn-sm btn-primary">{{ ux_icon('lucide:pencil', {class: 'size-3.5'}) }} Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="py-8 text-center text-slate-500">{{ filtre_actif ? 'Aucun jeu ne correspond aux filtres.' : 'Aucun jeu dans les collections.' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}