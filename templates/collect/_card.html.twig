{# Fiche d'un jeu dans la collection d'un utilisateur. Usage : include('collect/_card.html.twig', {collect: collect}) #}
{% set jeu = collect.jeuVideo %}
<div class="card">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-start gap-4">
            {% if jeu.imageUrl %}
                <img src="{{ asset('uploads/' ~ jeu.imageUrl) }}" alt="Jaquette de {{ jeu.titre }}" class="h-28 w-20 shrink-0 rounded-md object-cover">
            {% endif %}
            <div>
                <h2 class="text-lg font-semibold text-slate-900">{{ jeu.titre }}</h2>
                <p class="text-sm text-slate-500">Collection de {{ collect.utilisateur.prenom }} {{ collect.utilisateur.nom|upper }}</p>
            </div>
        </div>
        {{ include('collect/_statut_badge.html.twig', {collect: collect}) }}
    </div>

    <dl class="mt-5 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
        <div><dt class="text-slate-500">Éditeur</dt><dd class="font-medium text-slate-900">{{ jeu.editeur.nom|default('—') }}</dd></div>
        <div><dt class="text-slate-500">Développeur</dt><dd class="font-medium text-slate-900">{{ jeu.developpeur|default('—') }}</dd></div>
        <div><dt class="text-slate-500">Genre</dt><dd class="font-medium text-slate-900">{{ jeu.genre.nom|default('—') }}</dd></div>
        <div><dt class="text-slate-500">Date de sortie</dt><dd class="font-medium text-slate-900">{{ jeu.dateSortie ? jeu.dateSortie|date('d/m/Y') : '—' }}</dd></div>
        <div>
            <dt class="text-slate-500">Prix du jeu</dt>
            <dd class="font-medium text-slate-900">{{ jeu.prix is not null ? (jeu.prix + 0)|format_currency('EUR', locale: 'fr') : '—' }}</dd>
        </div>
        <div>
            <dt class="text-slate-500">Acheté</dt>
            <dd class="font-medium text-slate-900">
                {{ collect.prixAchat|format_currency('EUR', locale: 'fr') }}
                {% if collect.dateAchat %}le {{ collect.dateAchat|date('d/m/Y') }}{% endif %}
                {% if jeu.prix is not null %}
                    <span class="font-normal text-slate-500">(écart :</span> {{ include('collect/_ecart.html.twig', {collect: collect}) }}<span class="font-normal text-slate-500">)</span>
                {% endif %}
            </dd>
        </div>
        <div>
            <dt class="text-slate-500">Statut modifié le</dt>
            <dd class="font-medium text-slate-900">{{ collect.dateModifStatut ? collect.dateModifStatut|date('d/m/Y H:i') : '—' }}</dd>
        </div>
    </dl>

    {% if collect.commentaire %}
        <p class="mt-5 border-t border-slate-100 pt-4 text-sm italic text-slate-600">« {{ collect.commentaire }} »</p>
    {% endif %}
</div>