<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}MS-AD{% endblock %}</title>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-slate-100 font-sans text-slate-900 antialiased">
        {% set route = app.request.attributes.get('_route') ?? '' %}

        <div class="mx-auto flex min-h-screen max-w-7xl flex-col gap-4 p-4 md:p-6">

            {# ============================ HEADER ============================ #}
            {% block header %}
                <header class="flex items-center justify-between rounded-2xl bg-white px-6 py-4 shadow-sm ring-1 ring-slate-200">
                    <a href="{{ path('default_index') }}" class="flex items-center gap-3">
                        <span class="flex size-10 items-center justify-center rounded-xl bg-indigo-600 text-white">{{ ux_icon('lucide:gamepad-2', {class: 'size-6'}) }}</span>
                        <span class="text-xl font-bold tracking-tight text-slate-800">MS-AD</span>
                    </a>
                    <p class="hidden text-sm text-slate-500 sm:block">Gestion de jeux vidéo</p>
                </header>
            {% endblock %}

            <div class="flex flex-1 flex-col gap-4 md:flex-row">

                {# ============================= MENU ============================= #}
                {% block menu %}
                    {% set menu_items = [
                        {label: 'Accueil',    route: 'default_index',       prefix: 'default_',       icon: 'lucide:house'},
                        {label: 'Jeux vidéo', route: 'app_jeu_video_index', prefix: 'app_jeu_video_', icon: 'lucide:gamepad-2'},
                        {label: 'Éditeurs',   route: 'app_editeur_index',   prefix: 'app_editeur_',   icon: 'lucide:building-2'},
                        {label: 'Genres',     route: 'app_genre_index',     prefix: 'app_genre_',     icon: 'lucide:tags'},
                        {label: 'Collections de jeux vidéos', route: 'app_collect_index', prefix: 'app_collect_', icon: 'lucide:layers'},
                    ] %}
                    <aside class="shrink-0 rounded-2xl bg-slate-800 p-4 text-slate-100 shadow-sm md:w-60">
                        <p class="mb-3 px-3 text-xs font-semibold tracking-wider text-slate-400 uppercase">Menu</p>
                        <nav class="flex flex-row flex-wrap gap-1 md:flex-col">
                            {% for item in menu_items %}
                                {% set active = route starts with item.prefix %}
                                <a href="{{ path(item.route) }}"
                                   class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors {{ active ? 'bg-indigo-600 text-white' : 'text-slate-300 hover:bg-slate-700 hover:text-white' }}"
                                   {% if active %}aria-current="page"{% endif %}>
                                    {{ ux_icon(item.icon, {class: 'size-5 shrink-0'}) }}
                                    {{ item.label }}
                                </a>
                            {% endfor %}
                        </nav>
                    </aside>
                {% endblock %}

                <div class="flex min-w-0 flex-1 flex-col gap-4">

                    {# ========================== BREADCRUMB ========================== #}
                    {% block breadcrumb %}
                        <nav class="rounded-full bg-slate-200 px-5 py-2 text-sm text-slate-600" aria-label="Fil d'Ariane">
                            <ol class="flex flex-wrap items-center gap-1">
                                <li>
                                    <a href="{{ path('default_index') }}" class="flex items-center gap-1 transition-colors hover:text-indigo-600">
                                        {{ ux_icon('lucide:house', {class: 'size-4'}) }}
                                        Accueil
                                    </a>
                                </li>
                                {% block breadcrumb_items %}{% endblock %}
                            </ol>
                        </nav>
                    {% endblock %}

                    {# =========================== CONTENU ============================ #}
                    <main class="flex-1">
                        {% block body %}{% endblock %}
                    </main>
                </div>
            </div>

            {# ============================ FOOTER ============================ #}
            {% block footer %}
                <footer class="flex flex-col items-center justify-between gap-2 rounded-2xl bg-slate-700 px-6 py-4 text-sm text-slate-200 sm:flex-row">
                    <p>&copy; {{ 'now'|date('Y') }} MS-AD</p>
                    <p>Alexandre DUCOURET &amp; Mathis SAUVAGE — Groupe G7A</p>
                </footer>
            {% endblock %}
        </div>
    </body>
</html>
