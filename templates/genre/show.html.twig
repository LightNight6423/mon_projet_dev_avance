{% extends 'base.html.twig' %}

{% block title %}Genre {{ genre.nom }}{% endblock %}

{% block breadcrumb_items %}
    {{ include('_partials/breadcrumb_item.html.twig', {label: 'Genres', url: path('app_genre_index')}) }}
    {{ include('_partials/breadcrumb_item.html.twig', {label: genre.nom}) }}
{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="page-title">{{ genre.nom }}</h1>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('app_genre_index') }}" class="btn">{{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }} Retour à la liste</a>
            <a href="{{ path('app_genre_edit', {'id': genre.id}) }}" class="btn btn-primary">{{ ux_icon('lucide:pencil', {class: 'size-4'}) }} Modifier</a>
            {{ include('genre/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="card overflow-hidden p-0">
        <table class="table">
            <tbody>
                <tr><th>Id</th><td>{{ genre.id }}</td></tr>
                <tr><th>Nom</th><td>{{ genre.nom }}</td></tr>
                <tr><th>Description</th><td>{{ genre.description }}</td></tr>
                <tr>
                    <th>Actif</th>
                    <td>
                        {% if genre.actif %}
                            <span class="badge badge-success">Oui</span>
                        {% else %}
                            <span class="badge badge-muted">Non</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
{% endblock %}
