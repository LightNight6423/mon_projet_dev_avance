<form method="post" action="{{ path('app_genre_delete', {'id': genre.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ genre.nom|e('js') }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ genre.id) }}">
    <button class="btn btn-danger">{{ ux_icon('lucide:trash-2', {class: 'size-4'}) }} Supprimer</button>
</form>
