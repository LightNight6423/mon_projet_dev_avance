{% extends 'base.html.twig' %}

{% block title %}Genres{% endblock %}

{% block breadcrumb_items %}
    {{ include('_partials/breadcrumb_item.html.twig', {label: 'Genres'}) }}
{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="page-title">Liste des genres</h1>
        <a href="{{ path('app_genre_new') }}" class="btn btn-primary">{{ ux_icon('lucide:plus', {class: 'size-4'}) }} Ajouter un genre</a>
    </div>

    <div class="card overflow-x-auto p-0">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Actif</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for genre in genres %}
                <tr>
                    <td class="text-slate-400">{{ genre.id }}</td>
                    <td class="font-medium text-slate-900">{{ genre.nom }}</td>
                    <td class="max-w-md truncate">{{ genre.description }}</td>
                    <td>
                        {% if genre.actif %}
                            <span class="badge badge-success">Oui</span>
                        {% else %}
                            <span class="badge badge-muted">Non</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="flex justify-end gap-2">
                            <a href="{{ path('app_genre_show', {'id': genre.id}) }}" class="btn btn-sm">{{ ux_icon('lucide:eye', {class: 'size-3.5'}) }} Consulter</a>
                            <a href="{{ path('app_genre_edit', {'id': genre.id}) }}" class="btn btn-sm btn-primary">{{ ux_icon('lucide:pencil', {class: 'size-3.5'}) }} Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="py-8 text-center text-slate-500">Aucun genre trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
