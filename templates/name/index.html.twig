{% extends 'base.html.twig' %}

{% block title %}Hello NameController!{% endblock %}

{% block breadcrumb_items %}
    {{ include('_partials/breadcrumb_item.html.twig', {label: 'Name'}) }}
{% endblock %}

{% block body %}
    <div class="card max-w-3xl">
        <h1 class="page-title mb-3">Hello {{ controller_name }}! ✅</h1>
        <p class="mb-2 text-slate-600">This friendly message is coming from:</p>
        <ul class="list-disc space-y-1 pl-6 text-sm text-slate-600">
            <li>Your controller at <code class="rounded bg-slate-100 px-1.5 py-0.5">src/Controller/NameController.php</code></li>
            <li>Your template at <code class="rounded bg-slate-100 px-1.5 py-0.5">templates/name/index.html.twig</code></li>
        </ul>
    </div>
{% endblock %}
