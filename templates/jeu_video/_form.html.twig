{{ form_start(form, {attr: {class: 'form-stack'}}) }}
    <div class="grid gap-5 sm:grid-cols-2">
        {{ form_row(form.titre) }}
        {{ form_row(form.developpeur) }}
        {{ form_row(form.dateSortie) }}

        <div>
            {{ form_label(form.prix) }}
            <div class="flex">
                {{ form_widget(form.prix, {attr: {class: 'rounded-r-none'}}) }}
                <span class="inline-flex items-center rounded-r-lg border border-l-0 border-slate-300 bg-slate-100 px-3 text-sm text-slate-600">€</span>
            </div>
            {{ form_help(form.prix) }}
            {{ form_errors(form.prix) }}
        </div>

        {{ form_row(form.editeur) }}
        {{ form_row(form.genre) }}
    </div>

    {{ form_row(form.description) }}
    {{ form_row(form.image) }}

    {{ form_rest(form) }}

    <div>
        <button class="btn btn-primary">{{ ux_icon('lucide:save', {class: 'size-4'}) }} {{ button_label|default('Enregistrer') }}</button>
    </div>
{{ form_end(form) }}
