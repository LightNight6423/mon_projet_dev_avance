{% extends 'base.html.twig' %}

{% block title %}JeuVideo index{% endblock %}

{% block breadcrumb_items %}
    <li class="flex items-center">
        <svg class="w-4 h-4 text-gray-400 mx-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-gray-800 font-medium">Liste des jeux vidéo</span>
    </li>
{% endblock %}

{% block body %}
    <h1>JeuVideo index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Images</th>
                <th>Titre</th>
                <th>Developpeur</th>
                <th>DateSortie</th>
                <th>Prix</th>
                <th>Description</th>
                <th>Editeur</th>
                <th>Genre</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for jeu_video in jeu_videos %}
            <tr>
                <td>{{ jeu_video.id }}</td>
                <td>
                    {% if jeu_video.imageUrl %}
                        <img src="{{ asset('uploads/' ~ jeu_video.imageUrl) }}" alt="{{ jeu_video.titre }}" width="200">
                    {% endif %}
                </td>
                <td>{{ jeu_video.titre }}</td>
                <td>{{ jeu_video.developpeur }}</td>
                <td>{{ jeu_video.dateSortie ? jeu_video.dateSortie|date('d/m/Y') : '' }}</td>
                <td>{{ jeu_video.prix | replace({'.': ','}) }}  {{ '€' }}</td>
                <td>{{ jeu_video.description }}</td>
                <td>{{ jeu_video.editeur.nom }}</td>
                <td>{{ jeu_video.genre.nom }}</td>
                <td>
                    <a href="{{ path('app_jeu_video_show', {'id': jeu_video.id}) }}">Consulter</a>
                    <a href="{{ path('app_jeu_video_edit', {'id': jeu_video.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_jeu_video_new') }}">Ajouter un jeu</a>
{% endblock %}
