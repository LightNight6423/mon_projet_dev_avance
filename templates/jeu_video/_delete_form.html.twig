<form method="post" action="{{ path('app_jeu_video_delete', {'id': jeu_video.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ jeu_video.titre|e('js') }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jeu_video.id) }}">
    <button class="btn btn-danger">{{ ux_icon('lucide:trash-2', {class: 'size-4'}) }} Supprimer ce jeu</button>
</form>
