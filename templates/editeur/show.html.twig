{% extends 'base.html.twig' %}

{% block title %}Éditeur {{ editeur.nom }}{% endblock %}

{% block breadcrumb_items %}
    {{ include('_partials/breadcrumb_item.html.twig', {label: 'Éditeurs', url: path('app_editeur_index')}) }}
    {{ include('_partials/breadcrumb_item.html.twig', {label: editeur.nom}) }}
{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="page-title">{{ editeur.nom }}</h1>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('app_editeur_index') }}" class="btn">{{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }} Retour à la liste</a>
            <a href="{{ path('app_editeur_edit', {'id': editeur.id}) }}" class="btn btn-primary">{{ ux_icon('lucide:pencil', {class: 'size-4'}) }} Modifier</a>
            {{ include('editeur/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="card overflow-hidden p-0">
        <table class="table">
            <tbody>
                <tr><th>Id</th><td>{{ editeur.id }}</td></tr>
                <tr><th>Nom</th><td>{{ editeur.nom }}</td></tr>
                <tr><th>Pays</th><td>{{ editeur.pays }}</td></tr>
                <tr>
                    <th>Site web</th>
                    <td>
                        {% if editeur.siteWeb %}
                            <a href="{{ editeur.siteWeb }}" class="link" target="_blank" rel="noopener">{{ editeur.siteWeb }} {{ ux_icon('lucide:external-link', {class: 'inline size-3.5 align-[-2px]'}) }}</a>
                        {% endif %}
                    </td>
                </tr>
                <tr><th>Description</th><td>{{ editeur.description }}</td></tr>
                <tr><th>Date de création</th><td>{{ editeur.createdAt ? editeur.createdAt|date('d/m/Y H:i:s') : '' }}</td></tr>
                <tr><th>Date de modification</th><td>{{ editeur.updatedAt ? editeur.updatedAt|date('d/m/Y H:i:s') : '' }}</td></tr>
            </tbody>
        </table>
    </div>
{% endblock %}
